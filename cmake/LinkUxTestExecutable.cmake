file(REAL_PATH "${UX_BUILD_ROOT}" UX_BUILD_ROOT)
file(REAL_PATH "${UX_PROJECT_ROOT}" UX_PROJECT_ROOT)
set(launcher "${UX_BUILD_ROOT}/luma_ux_tests")
if(NOT UX_BUNDLE_EXECUTABLE STREQUAL "${UX_BUILD_ROOT}/luma_ux_tests.app/Contents/MacOS/luma_ux_tests")
    message(FATAL_ERROR "Unexpected UX bundle executable path")
endif()
if(IS_SYMLINK "${launcher}")
    file(READ_SYMLINK "${launcher}" previous)
    if(NOT previous STREQUAL UX_BUNDLE_EXECUTABLE)
        message(FATAL_ERROR "Refusing to replace another UX launcher symlink")
    endif()
    return()
elseif(EXISTS "${launcher}")
    if(NOT IS_DIRECTORY "${launcher}")
        file(SIZE "${launcher}" bytes)
    endif()
    if(IS_DIRECTORY "${launcher}" OR NOT bytes GREATER 0 OR NOT EXISTS "${UX_BUILD_ROOT}/ux-build-provenance.json")
        message(FATAL_ERROR "Flat UX migration requires its prior provenance; configure before build_ux removes that record")
    endif()
    file(STRINGS "${UX_BUILD_ROOT}/CMakeCache.txt" project REGEX "^CMAKE_PROJECT_NAME:STATIC=")
    file(STRINGS "${UX_BUILD_ROOT}/CMakeCache.txt" home REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
    file(READ "${UX_BUILD_ROOT}/ux-build-provenance.json" proof)
    string(JSON expected ERROR_VARIABLE invalid GET "${proof}" test_executable_sha256)
    file(SHA256 "${launcher}" actual)
    if(invalid OR NOT project STREQUAL "CMAKE_PROJECT_NAME:STATIC=Luma" OR
       NOT home STREQUAL "CMAKE_HOME_DIRECTORY:INTERNAL=${UX_PROJECT_ROOT}" OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Refusing to replace an unverified flat UX executable")
    endif()
endif()
file(CREATE_LINK "${UX_BUNDLE_EXECUTABLE}" "${launcher}" SYMBOLIC)
